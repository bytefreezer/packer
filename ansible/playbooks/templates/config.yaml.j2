# ByteFreezer Packer Configuration
# Generated by Ansible on {{ ansible_date_time.iso8601 }}
# Host: {{ ansible_hostname }}

app:
  name: {{ config.app.name }}
  version: {{ config.app.version }}
  deployment_type: {{ config.app.deployment_type | default('managed') }}

# Logging configuration
logging:
  level: {{ config.logging.level }}
  encoding: {{ config.logging.encoding }}

# API server configuration
server:
  api_port: {{ config.server.api_port }}

# ByteFreezer configuration
bytefreezer:
  cache_path: {{ config.bytefreezer.cache_path }}
  spool_path: {{ config.bytefreezer.spool_path }}

# Control Service configuration (replaces dev mode and legacy controller)
control_service:
  enabled: {{ config.control_service.enabled | lower }}
  base_url: {{ config.control_service.base_url }}
  api_key: "{{ bytefreezer_api_key }}"
  timeout_seconds: {{ config.control_service.timeout_seconds }}

# OpenTelemetry configuration
otel:
  enabled: {{ config.otel.enabled | lower }}
  service_name: {{ config.otel.service_name }}
  scrapeintervalseconds: {{ config.otel.scrapeintervalseconds }}
  # Prometheus mode - expose metrics on HTTP endpoint for scraping
  prometheus_mode: {{ config.otel.prometheus_mode | lower }}
  metrics_port: {{ config.otel.metrics_port }}
  # Bind to all interfaces for external scraping
  metrics_host: {{ config.otel.metrics_host }}

# Housekeeping configuration
housekeeping:
  enabled: {{ config.housekeeping.enabled | lower }}
  intervalseconds: {{ config.housekeeping.intervalseconds }}
  cleanup:
    enabled: {{ config.housekeeping.cleanup.enabled | lower }}
    processing_dir_max_age_hours: {{ config.housekeeping.cleanup.processing_dir_max_age_hours }}
    orphaned_files_max_age_hours: {{ config.housekeeping.cleanup.orphaned_files_max_age_hours }}
    lock_cleanup:
      enabled: {{ config.housekeeping.cleanup.lock_cleanup.enabled | default(true) | lower }}
      stale_threshold_minutes: {{ config.housekeeping.cleanup.lock_cleanup.stale_threshold_minutes | default(5) }}

# S3 source configuration - where compressed NDJSON files are read from
s3source:
  bucket_name: {{ config.s3source.bucket_name }}
  region: {{ config.s3source.region }}
  endpoint: "{{ bytefreezer_s3_endpoint }}"
  ssl: {{ config.s3source.ssl | lower }}
  access_key: "{{ bytefreezer_s3_access_key }}"
  secret_key: "{{ bytefreezer_s3_secret_key }}"
  use_iam_role: {{ config.s3source.use_iam_role | default(false) | lower }}

# S3 destination configuration removed - now using per-tenant:dataset destinations

# Parquet processing configuration
{% if config.parquet is defined %}
parquet:
  max_file_size_mb: {{ config.parquet.max_file_size_mb | default(64) }}
  timeout_seconds: {{ config.parquet.timeout_seconds | default(300) }}  # Default 5 minutes = 300 seconds
  compression: {{ config.parquet.compression | default('zstd') }}
  keep_source: {{ config.parquet.keep_source | default(false) | lower }}
  streaming_mode: {{ config.parquet.streaming_mode | default(true) | lower }}
  memory_buffer_mb: {{ config.parquet.memory_buffer_mb | default(32) }}
  checkpoint_records: {{ config.parquet.checkpoint_records | default(10000) }}
  atomic_upload: {{ config.parquet.atomic_upload | default(true) | lower }}
{% else %}
# Default Parquet configuration for streaming mode
parquet:
  max_file_size_mb: 64
  timeout_seconds: 300  # 5 minutes
  compression: "zstd"
  keep_source: false
  streaming_mode: true
  memory_buffer_mb: 32
  checkpoint_records: 10000
  atomic_upload: true
{% endif %}

# Upload pool configuration
uploadpool:
  worker_count: {{ config.uploadpool.worker_count }}
  cleanup_source_files: {{ config.uploadpool.cleanup_source_files | lower }}

# Tenant and dataset failure tracking removed - functionality disabled

# SOC configuration
soc:
  enabled: {{ config.soc.enabled | lower }}

# Health reporting configuration for service registration and monitoring
health_reporting:
  enabled: {{ config.health_reporting.enabled | default(true) | lower }}
  report_interval: {{ config.health_reporting.report_interval | default(30) }}
  timeout_seconds: {{ config.health_reporting.timeout_seconds | default(10) }}
  register_on_startup: {{ config.health_reporting.register_on_startup | default(true) | lower }}

# Error tracking configuration
error_tracking:
  enabled: {{ config.error_tracking.enabled | default(true) | lower }}

# Development mode
dev: {{ config.dev | lower }}